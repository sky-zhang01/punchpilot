{
  "name": "punchpilot",
  "version": "0.4.13",
  "description": "Smart attendance automation for freee HR - auto clock-in/out with Web GUI and intelligent scheduling",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "install-browsers": "playwright install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:watch": "vitest",
    "lint:security": "npx eslint --config eslint.config.mjs 'server/**/*.js'",
    "audit": "npm audit",
    "scan:dockerfile": "hadolint Dockerfile"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.5.0",
    "playwright": "^1.61.1"
  },
  "keywords": [
    "freee",
    "attendance",
    "automation",
    "playwright",
    "scheduler",
    "docker"
  ],
  "author": "sky-zhang01",
  "repository": {
    "type": "git",
    "url": "https://github.com/sky-zhang01/punchpilot.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
