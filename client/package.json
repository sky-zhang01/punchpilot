{
  "name": "punchpilot-client",
  "private": true,
  "version": "0.5.10",
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26.13 <27",
    "npm": ">=12.2.2 <13"
  },
  "allowScripts": {
    "fsevents": false
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@reduxjs/toolkit": "^2.14.0",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
