# PunchPilot Configuration
# Copy this file to .env and fill in your values

# Timezone (default: Asia/Tokyo)
TZ=Asia/Tokyo

# Server port (default: 8681)
PORT=8681

# Container runtime identity. TrueNAS Apps commonly use 568:568.
PUID=1000
PGID=1000

# Published multi-architecture image. Pin a release digest for strict production immutability.
# PUNCHPILOT_IMAGE=ghcr.io/sky-zhang01/punchpilot:0.5.0

# Reverse-proxy headers are ignored unless the proxy peer is explicitly trusted.
# Use exact IP/CIDR entries where possible. Named private ranges are supported
# for container networks: loopback,linklocal,uniquelocal
# TRUST_PROXY=loopback

# Canonical browser origin. Required for non-loopback deployments so browser
# write protection, Secure cookies, HSTS, and OAuth redirects do not trust
# incoming Host or forwarded-protocol headers.
# Use HTTPS outside localhost. OAUTH_REDIRECT_URI is only needed when the freee
# app registration uses an explicit callback URL on this same origin.
# PUNCHPILOT_PUBLIC_ORIGIN=https://punchpilot.example.com
# OAUTH_REDIRECT_URI=https://punchpilot.example.com/api/config/oauth-callback

# Allow the current scheduler, browser, batch, account, and HTTP operations to drain.
SHUTDOWN_GRACE_MS=510000

# The encryption secret is generated and persisted in keystore/ by default.
# Set APP_SECRET only when an external secret manager requires it. It must be at
# least 32 bytes and must keep matching the persisted keystore secret.
# APP_SECRET=

# Instance storage paths (relative paths are resolved from the launch directory).
# Defaults are anchored to the application; logs follow the selected database directory.
# PUNCHPILOT_DB_PATH=/path/to/private/data/punchpilot.db
# PUNCHPILOT_KEYSTORE_DIR=/path/to/private/keystore
# PUNCHPILOT_LOG_DIR=/path/to/private/logs
# SCREENSHOTS_DIR=/path/to/private/screenshots
# Legacy encryption key migration defaults to .app-secret beside the selected database.
# When moving an existing database, preserve its matching keystore or point explicitly
# to the original legacy key; a database copy alone cannot recover encrypted credentials.
# PUNCHPILOT_LEGACY_APP_SECRET_FILE=/path/to/original/data/.app-secret

# Fresh databases generate a one-time admin password in the keystore by default.
# To supply your own, use exactly one of these and keep it out of source control.
# Existing password files must be regular files owned by the app user and mode 0600.
# Factory reset removes the generated keystore password, but preserves external
# password files outside that path. Rotate or remove externally supplied credentials
# before restarting if the reset should also change the initial password.
# PUNCHPILOT_INITIAL_ADMIN_PASSWORD=your-initial-admin-password
# PUNCHPILOT_INITIAL_ADMIN_PASSWORD_FILE=/path/to/private-initial-admin-password

# Browser screenshots are disabled by default because attendance pages contain personal data.
# Set to "errors" or "all" only for short, controlled diagnostic sessions.
BROWSER_SCREENSHOTS=off

# Browser process/session reuse, queue wait, and hard operation deadline (milliseconds).
# AUTOMATION_OPERATION_TIMEOUT_MS must stay between 1 and 480000.
# Standard docker compose enables the Chromium sandbox with the bundled seccomp profile.
# Image-only deployments should enable this only after applying that profile.
# CHROMIUM_SANDBOX=false
BROWSER_IDLE_TIMEOUT_MS=300000
BROWSER_SESSION_TTL_MS=28800000
AUTOMATION_QUEUE_TIMEOUT_MS=540000
AUTOMATION_OPERATION_TIMEOUT_MS=480000

# Browser-only deployments must identify the exact freee company before writes.
# GUI configuration takes precedence; this is for environment-managed installs.
# LOGIN_USERNAME=your-freee-login
# LOGIN_PASSWORD=your-freee-password
# FREEE_COMPANY_NAME=Example Company
